#!/bin/bash

# omarchy:summary=Copy text to the clipboard and type or paste it
# omarchy:group=clipboard
# omarchy:args=[--shift-insert|--universal] [--copy-only] [--history-index <index>|<text>]
# omarchy:examples=omarchy clipboard paste text "hello" | omarchy clipboard paste text --shift-insert "hello"
# omarchy:hidden=true

use_shift_insert=false
use_universal=false
copy_only=false
history_index=""
text=""

while (( $# > 0 )); do
  case "$1" in
    --shift-insert)
      use_shift_insert=true
      shift
      ;;
    --universal)
      use_universal=true
      shift
      ;;
    --copy-only)
      copy_only=true
      shift
      ;;
    --history-index)
      history_index="${2:-}"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

copy_history_entry() {
  local history_path="$HOME/.local/state/omarchy/clipboard-history.json"

  [[ $history_index =~ ^[0-9]+$ ]] || exit
  [[ -r $history_path ]] || exit
  jq -e --argjson index "$history_index" '.[$index].type == "text" and (.[$index].text | type == "string")' "$history_path" >/dev/null || exit
  jq -j --argjson index "$history_index" '.[$index].text' "$history_path" | wl-copy
}

if [[ -n $history_index ]]; then
  copy_history_entry
  if [[ $copy_only != "true" && $use_universal != "true" && $use_shift_insert != "true" ]]; then
    use_universal=true
  fi
else
  text=${1:-}
  [[ -n $text ]] || exit
  printf '%s' "$text" | wl-copy
fi

if [[ $copy_only == "true" ]]; then
  exit
fi

sleep 0.2

# Universal paste presses Ctrl+V (with delay so compositor processes modifier),
# with fallback to Shift+Insert for terminal emulators.
if [[ $use_shift_insert == "true" ]]; then
  wtype -M shift -s 50 -k Insert -s 20 -m shift 2>/dev/null || true
elif [[ $use_universal == "true" ]]; then
  wtype -M ctrl -s 50 -k v -s 20 -m ctrl 2>/dev/null || wtype -M shift -s 50 -k Insert -s 20 -m shift 2>/dev/null || true
else
  wtype -M ctrl -s 50 -k v -s 20 -m ctrl 2>/dev/null || wtype "$text" 2>/dev/null || true
fi
