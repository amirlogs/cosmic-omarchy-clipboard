#!/usr/bin/env bash
# Removes orphaned image files in clipboard-images/ not referenced by history.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
HISTORY_FILE="$STATE_DIR/clipboard-history.json"
IMAGE_DIR="$STATE_DIR/clipboard-images"

[[ -d $IMAGE_DIR && -r $HISTORY_FILE ]] || exit 0

python3 - "$HISTORY_FILE" "$IMAGE_DIR" <<'PY'
import json, os, sys, time

history_path, image_dir = sys.argv[1:3]
try:
    with open(history_path, "r") as f:
        data = json.load(f)
except Exception:
    sys.exit(0)

items = data.get("entries", []) if isinstance(data, dict) else (data if isinstance(data, list) else [])
referenced = set()
for item in items:
    if isinstance(item, dict) and item.get("type") == "image" and item.get("path"):
        referenced.add(os.path.abspath(str(item["path"])))

now = time.time()
for name in os.listdir(image_dir):
    full = os.path.abspath(os.path.join(image_dir, name))
    if not os.path.isfile(full) or full in referenced:
        continue
    # Skip files modified in the last 60s to avoid racing active captures.
    try:
        if now - os.path.getmtime(full) > 60:
            os.unlink(full)
    except OSError:
        pass
PY
